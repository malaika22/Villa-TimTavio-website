# Copy to .env.local and fill in your values. Never commit real secrets.

# Cloudinary cloud name — browser-safe (NEXT_PUBLIC_); powers the /lookbook deck imagery
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Resend API key — sends invitation-form emails via /api/notify-invitation
RESEND_API_KEY=your_resend_api_key

# Estate-manager API (NestJS) — where invitation inquiries are forwarded for the dashboard
MONOREPO_API_URL=https://your-dashboard-api.example.com

# ── Broker availability page ──
# Shared secret between this site's server and the estate API. Must match
# BROKER_API_SECRET in the monorepo. Server-side only — never NEXT_PUBLIC_.
BROKER_API_SECRET=

# The unguessable path segment the broker calendar lives behind:
#   /availability/<BROKER_PAGE_KEY>
# One link is issued to every broker, so treat this as the link itself.
# Unset means the page 404s. Use a long random string.
BROKER_PAGE_KEY=
